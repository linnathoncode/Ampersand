{
  "table_name": "tool_definitions",
  "add_base_columns": true,
  "columns": [
    {
      "name": "model_version_id",
      "type": "uuid",
      "notNull": true,
      "unique": true,
      "references": {
        "table": "model_versions",
        "column": "id",
        "onDelete": "restrict"
      }
    },
    {
      "name": "tool_name",
      "type": "varchar",
      "length": 255,
      "notNull": true,
      "unique": true,
      "sanitize": ["trim"]
    },
    {
      "name": "description",
      "type": "text",
      "notNull": true,
      "sanitize": ["trim"]
    },
    {
      "name": "input_schema",
      "type": "jsonb",
      "notNull": true
    },
    {
      "name": "output_schema",
      "type": "jsonb",
      "notNull": true
    },
    {
      "name": "generator_version",
      "type": "varchar",
      "length": 50,
      "notNull": true
    },
    {
      "name": "schema_sha256",
      "type": "char",
      "length": 64,
      "notNull": true,
      "unique": true
    },
    {
      "name": "generated_at",
      "type": "timestamptz",
      "notNull": true
    }
  ]
}
