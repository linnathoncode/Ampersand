{
  "$schema": "../node_modules/nucleus-core-ts/schemas/config.nucleus.json",
  "appId": "ampersand-api",
  "mode": "development",
  "database": {
    "url": "DATABASE_URL",
    "isMultiTenant": true
  },
  "authentication": {
    "enabled": true,
    "mode": "full",
    "defaultRole": "basic",
    "accessToken": {
      "secret": "ACCESS_TOKEN_SECRET",
      "expiresIn": "15m"
    },
    "refreshToken": {
      "secret": "REFRESH_TOKEN_SECRET",
      "expiresIn": "30d"
    },
    "sessionToken": {
      "secret": "SESSION_TOKEN_SECRET"
    },
    "login": {
      "enabled": true
    },
    "register": {
      "enabled": false
    },
    "logout": {
      "enabled": true
    },
    "refresh": {
      "enabled": true
    }
  },
  "authorization": {
    "enabled": true,
    "autoSeedClaims": false,
    "godminEmail": "GODMIN_EMAIL",
    "godminPassword": "GODMIN_PASSWORD"
  }
}
