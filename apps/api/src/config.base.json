{
  "appId": "ampersand-api",
  "mode": "development",
  "database": {
    "url": "DATABASE_URL",
    "isMultiTenant": true
  },
  "redis": {
    "url": "REDIS_URL"
  },
  "email": {
    "provider": "azure",
    "azure": {
      "enabled": true,
      "connection_string": "AZURE_EMAIL_CONNECTION_STRING",
      "sender_address": "AZURE_EMAIL_SENDER",
      "from_name": "Ampersand"
    }
  },
  "rateLimit": {
    "enabled": true,
    "strategy": "sliding-window",
    "keyPrefix": "ampersand:rate-limit:",
    "failClosed": true,
    "authRoutes": {
      "login": {
        "window": "1m",
        "max": 30,
        "blockDuration": "1m"
      }
    },
    "privateRoutes": {
      "window": "1m",
      "max": 60
    },
    "byIp": true,
    "byUserId": true,
    "byEndpoint": true,
    "skipSuccessfulRequests": false,
    "headers": {
      "remaining": "X-RateLimit-Remaining",
      "reset": "X-RateLimit-Reset",
      "limit": "X-RateLimit-Limit"
    }
  },
  "authentication": {
    "enabled": true,
    "mode": "full",
    "defaultRole": "basic",
    "accessToken": {
      "secret": "ACCESS_TOKEN_SECRET",
      "expiresIn": "15m"
    },
    "refreshToken": {
      "secret": "REFRESH_TOKEN_SECRET",
      "expiresIn": "30d"
    },
    "sessionToken": {
      "secret": "SESSION_TOKEN_SECRET"
    },
    "login": {
      "enabled": true,
      "isPublic": true
    },
    "register": {
      "enabled": false
    },
    "invite": {
      "enabled": true,
      "isPublic": false,
      "tokenExpiresIn": "7d",
      "redirectUrl": "INVITE_REDIRECT_URL"
    },
    "passwordSet": {
      "enabled": true,
      "isPublic": true
    },
    "logout": {
      "enabled": true
    },
    "refresh": {
      "enabled": true
    }
  },
  "authorization": {
    "enabled": true,
    "autoSeedClaims": false,
    "godminEmail": "GODMIN_EMAIL",
    "godminPassword": "GODMIN_PASSWORD",
    "seed": {
      "roles": [
        {
          "name": "basic",
          "description": "Can invoke published prediction tools"
        },
        {
          "name": "model-publisher",
          "description": "Can publish candidate model versions"
        },
        {
          "name": "dataset-creator",
          "description": "Can create dataset definitions"
        },
        {
          "name": "tenant-admin",
          "description": "Can invite users to the tenant"
        }
      ],
      "claims": [
        {
          "action": "publish",
          "path": "model_versions",
          "method": "POST",
          "description": "Publish candidate model versions"
        },
        {
          "action": "retire",
          "path": "model_versions",
          "method": "POST",
          "description": "Retire published model versions"
        },
        {
          "action": "create",
          "path": "dataset_definitions",
          "method": "POST",
          "description": "Create dataset definitions"
        },
        {
          "action": "generate",
          "path": "tool_definitions",
          "method": "POST",
          "description": "Generate and store tool definitions"
        },
        {
          "action": "invoke",
          "path": "tool_definitions",
          "method": "POST",
          "description": "Invoke published prediction tools"
        },
        {
          "action": "invite",
          "path": "users",
          "method": "POST",
          "description": "Invite users to the tenant"
        },
        {
          "action": "cancel",
          "path": "training_jobs",
          "method": "POST",
          "description": "Cancel queued or running training jobs"
        }
      ],
      "roleClaimAssignments": [
        {
          "role": "model-publisher",
          "claims": [
            "publish",
            "retire",
            "generate"
          ]
        },
        {
          "role": "dataset-creator",
          "claims": [
            "create",
            "cancel"
          ]
        },
        {
          "role": "tenant-admin",
          "claims": [
            "invite",
            "cancel"
          ]
        },
        {
          "role": "basic",
          "claims": [
            "invoke"
          ]
        }
      ]
    },
    "publicPaths": [
      "POST /internal/training-jobs/:jobId/result"
    ]
  }
}
