{
  "name": "@ampersand/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "config:build": "bun scripts/build-config.ts",
    "config:validate": "bun run config:build && bunx nucleus-core-ts validate src/config.json",
    "schema:generate": "bun run config:build && bunx nucleus-core-ts generate src/config.json src/drizzle",
    "tenant:bootstrap": "bun --env-file=../../.env scripts/bootstrap-local-tenant.ts",
    "mock:training-job": "bun --env-file=../../.env scripts/mock-training-job.ts",
    "mock:training-failure": "bun --env-file=../../.env scripts/mock-training-failure.ts",
    "mock:tool-prediction": "bun --env-file=../../.env scripts/mock-tool-prediction.ts",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.46",
    "@ampersand/contracts": "workspace:*",
    "@elysiajs/cors": "1.4.2",
    "@sinclair/typebox": "0.34.52",
    "ai": "^7.0.77",
    "apache-arrow": "^21.2.0",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.29",
    "ioredis": "5.11.1",
    "nucleus-core-ts": "0.9.805",
    "onnxruntime-node": "^1.27.0",
    "parquet-wasm": "^0.7.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
