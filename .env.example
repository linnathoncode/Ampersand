DATABASE_URL=postgresql://ampersand:ampersand@localhost:5432/ampersand
REDIS_URL=redis://localhost:6379
ARTIFACT_STORAGE_PATH=./artifacts
TRUSTED_WORKER_IDS=worker-1
NUCLEUS_APP_ID=ampersand
GODMIN_EMAIL=admin@example.com
GODMIN_PASSWORD=change-me
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters
SESSION_TOKEN_SECRET=replace-with-at-least-32-random-characters
NUCLEUS_URL=http://localhost:4000
DEV_TENANT_SUBDOMAIN=ampersand-dev
DEV_TENANT_ADMIN_EMAIL=tenant-admin@example.com
DEV_TENANT_ADMIN_PASSWORD=change-me
LLM_API_KEY=
LLM_MODEL=qwen3:1.7b
LLM_BASE_URL=
NEXT_PUBLIC_NUCLEUS_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
INVITE_REDIRECT_URL=http://localhost:3000/invite/accept
NEXT_PUBLIC_DEV_TENANT_SUBDOMAIN=ampersand-dev
AZURE_EMAIL_CONNECTION_STRING=
AZURE_EMAIL_SENDER=
BOUNDARY_WARNING_RATIO=0.1
# Private Python worker (services/worker). Unset WORKER_ID to use a generated default.
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_LOG_LEVEL=INFO
# Upper bound (characters) for the per-job worker log tail in training_jobs.
WORKER_LOG_MAX_CHARS=8192
# Internal result-submission endpoint and shared bearer token (must match the API).
NUCLEUS_INTERNAL_URL=http://localhost:4000
NUCLEUS_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
TRAINING_MAX_ACTIVE_JOBS=5
# Running claims older than this are swept to dead before quota checks.
# Must stay well above WORKER_HEARTBEAT_INTERVAL_SECONDS.
TRAINING_HEARTBEAT_EXPIRY_SECONDS=180
INFERENCE_TENANT_DAILY_QUOTA=1000
