{
  "name": "ampersand",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "dev:api": "bun --cwd apps/api dev",
    "dev:web": "bun --cwd apps/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:integration": "tsc -p tests/integration",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "TRAINING_MAX_ACTIVE_JOBS=100 bun --env-file=.env vitest run --config tests/integration/vitest.integration.config.mts"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.80",
    "@ampersand/contracts": "workspace:*",
    "@playwright/test": "1.62.1",
    "@sinclair/typebox": "0.34.52",
    "@types/bun": "1.3.14",
    "@types/pg": "8.20.0",
    "apache-arrow": "21.2.0",
    "parquet-wasm": "0.7.2",
    "pg": "8.22.0",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  }
}
